# --- Claude (AI interviewer) ---
ANTHROPIC_API_KEY=

# --- Google (your account: Sheets + Calendar) ---
# OAuth client from Google Cloud Console. After filling these, open APP_URL/api/google/auth once;
# GOOGLE_REFRESH_TOKEN is then filled in automatically.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=
SHEET_TAB=Tracker

# --- Email (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where invites and reminders are sent
NOTIFY_EMAIL=

# --- App ---
APP_URL=http://localhost:3000
# Protects the website with a login prompt (any username, this password)
APP_PASSWORD=
# Any long random string; protects the scheduler endpoint
CRON_SECRET=
# Your timezone offset; sheet times are read in this zone
TZ_OFFSET=+05:30

# --- Rules ---
PASS_SCORE=7
RETRY_DAYS=3
INVITE_HOURS_BEFORE=24
REMIND_HOURS_BEFORE=24
DIGEST_HOUR=9
INTERVIEW_MINUTES=30

# --- Data source ---
# "excel" (default when the file exists) or "google"
DATA_SOURCE=excel
EXCEL_FILE=ML_Learning_Tracker.xlsx

# --- Office hours (study is planned around them; 0 = Sunday ... 6 = Saturday) ---
OFFICE_DAYS=1,2,3,4,5
OFFICE_START_HOUR=10
OFFICE_END_HOUR=19
# Sleep window: from SLEEP_START_HOUR (after midnight) until WAKE_HOUR
SLEEP_START_HOUR=4
WAKE_HOUR=9
